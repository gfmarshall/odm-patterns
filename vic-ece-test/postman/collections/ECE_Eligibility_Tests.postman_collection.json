    {
      "name": "Reference Date Tests",
      "item": [
        {
          "name": "Use Reference Date For Age Calculation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response should use reference date for calculations\", function () {",
                  "    const request = JSON.parse(pm.request.body.raw);",
                  "    const responseJson = pm.response.json();",
                  "    ",
                  "    // The child's birthday is 2023-05-15 and reference date is 2026-04-30",
                  "    // This should put them just under 3yo, making them ineligible",
                  "    const eligibilityResults = responseJson.eligibilityResults || [];",
                  "    const threeYOResult = eligibilityResults.find(r => r.scheme === 'THREE_YEAR_OLD_KINDER');",
                  "    ",
                  "    pm.expect(threeYOResult).to.exist;",
                  "    pm.expect(threeYOResult.status).to.equal('INELIGIBLE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Load the test data file",
                  "const fs = require('fs');",
                  "const testData = JSON.parse(fs.readFileSync('test-data/eligibility/age_tests/child_under_3.json'));",
                  "",
                  "// Modify it to use a different reference date",
                  "testData.referenceDate = \"2026-05-30\";",
                  "",
                  "// Set the modified data as the request body",
                  "pm.request.body.raw = JSON.stringify(testData);",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{eligibilityRulesetPath}}",
              "host": ["{{baseUrl}}{{eligibilityRulesetPath}}"]
            },
            "description": "Tests that age calculations are based on reference date rather than system time"
          },
          "response": []
        }
      ],
      "description": "Tests for reference date handling"
    },
