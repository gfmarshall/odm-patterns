  "item": [
    {
      "name": "Age Eligibility Tests",
      "item": [
        {
          "name": "Child Under 3 - Should be Ineligible",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "const responseJson = pm.response.json();",
                  "",
                  "pm.test(\"BaseProgramType should be undefined due to ineligibility\", function () {",
                  "    pm.expect(responseJson.baseProgramType).to.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"Should have ineligibility result for THREE_YEAR_OLD_KINDER\", function () {",
                  "    const eligibilityResults = responseJson.eligibilityResults || [];",
                  "    const threeYOResult = eligibilityResults.find(r => r.scheme === 'THREE_YEAR_OLD_KINDER');",
                  "    pm.expect(threeYOResult).to.exist;",
                  "    pm.expect(threeYOResult.status).to.equal('INELIGIBLE');",
                  "});",
                  "",
                  "pm.test(\"Should have ineligibility result for PRE_PREP\", function () {",
                  "    const eligibilityResults = responseJson.eligibilityResults || [];",
                  "    const prePrepResult = eligibilityResults.find(r => r.scheme === 'PRE_PREP');",
                  "    pm.expect(prePrepResult).to.exist;",
                  "    pm.expect(prePrepResult.status).to.equal('INELIGIBLE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": "test-data/eligibility/age_tests/child_under_3.json"
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{eligibilityRulesetPath}}",
              "host": ["{{baseUrl}}{{eligibilityRulesetPath}}"]
            },
            "description": "Tests eligibility for a child under 3 years old"
          },
          "response": []
        },
