<?xml version="1.0" encoding="UTF-8"?>
<com.ibm.rules.studio.model.decisiontable:DecisionTable xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:com.ibm.rules.studio.model.decisiontable="http://com.ibm.rules.studio/model/decisiontable.ecore">
  <name>Age Eligibility</name>
  <uuid>j9fnmdj-ffk9-4f64-9f8g-m24feiefeieq</uuid>
  <locale>en_US</locale>
  <definition>
<definitions xmlns="http://www.omg.org/spec/DMN/20180521/MODEL/" id="decisions" name="Age Eligibility" namespace="http://vic-ece-rules.odm.ibm.com/tables">
    <extensionElements/>
    <decision id="AgEligibility" name="Age Eligibility">
        <decisionTable hitPolicy="UNIQUE">
            <input id="input_1" label="Child's Age">
                <inputExpression>
                    <text>childAge</text>
                </inputExpression>
            </input>
            <output id="output_1" label="Program Eligibility" name="programEligibility">
                <outputValues>
                    <text>"THREE_YEAR_OLD_KINDER_ELIGIBLE", "PRE_PREP_ELIGIBLE", "NO_PROGRAM_ELIGIBLE"</text>
                </outputValues>
            </output>
            <output id="output_2" label="Reason" name="reason"/>
            <rule id="rule1">
                <inputEntry>
                    <text>&lt; 3</text>
                </inputEntry>
                <outputEntry>
                    <text>"NO_PROGRAM_ELIGIBLE"</text>
                </outputEntry>
                <outputEntry>
                    <text>"Child will be younger than 3 years old on cutoff date"</text>
                </outputEntry>
            </rule>
            <rule id="rule2">
                <inputEntry>
                    <text>[3..5)</text>
                </inputEntry>
                <outputEntry>
                    <text>"THREE_YEAR_OLD_KINDER_ELIGIBLE"</text>
                </outputEntry>
                <outputEntry>
                    <text>"Child is eligible for Three Year Old Kindergarten"</text>
                </outputEntry>
            </rule>
            <rule id="rule3">
                <inputEntry>
                    <text>[4..6)</text>
                </inputEntry>
                <outputEntry>
                    <text>"PRE_PREP_ELIGIBLE"</text>
                </outputEntry>
                <outputEntry>
                    <text>"Child is eligible for Pre-Prep"</text>
                </outputEntry>
            </rule>
            <rule id="rule4">
                <inputEntry>
                    <text>≥ 6</text>
                </inputEntry>
                <outputEntry>
                    <text>"NO_PROGRAM_ELIGIBLE"</text>
                </outputEntry>
                <outputEntry>
                    <text>"Child will be 6 years or older on cutoff date"</text>
                </outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
  </definition>
</com.ibm.rules.studio.model.decisiontable:DecisionTable>
