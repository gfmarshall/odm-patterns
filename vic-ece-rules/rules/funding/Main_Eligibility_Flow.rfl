      <Task name="Pre-Prep Rollout Check">
        <RuleTask href="eligibility/program/prep_rollout_rules#Pre_Prep_Rollout_Task"/>
      </Task>
      <Task name="Priority Group Determination">
        <RuleTask href="eligibility/program/priority_group_rules#Priority_Group_Task"/>
      </Task>
      <Task name="ESK Supplement Check">
        <RuleTask href="eligibility/supplements/esk_supplement_rules#ESK_Supplement_Task"/>
