<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <n>Provider Not Eligible</n>
  <uuid>c28fbg6c-f9d9-4f57-9f89-f17f9f8e9f7i</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the service provider from 'the eligibility request' is not Victorian kindergarten funding approved provider
    and the processing status of 'the eligibility response' is "IN_PROGRESS"
then
    create a new eligibility result with program type "PROVIDER_ELIGIBILITY" and status INELIGIBLE ;
    add reason "Provider is not approved or is non-compliant" to 'the eligibility result' ;
    add policy reference "PROVIDER_APPROVAL_POLICY_2.3" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;
    
    create a new eligibility result with program type "THREE_YEAR_OLD_KINDER" and status INELIGIBLE ;
    add reason "Service provider is not eligible to deliver funded programs" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;
    
    create a new eligibility result with program type "PRE_PREP" and status INELIGIBLE ;
    add reason "Service provider is not eligible to deliver funded programs" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
