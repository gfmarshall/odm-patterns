  <name>Main_Eligibility_Flow</name>
  <uuid>23fb0b10-349d-4785-9de7-75bca489a6f2</uuid>
  <locale>en_US</locale>
  <categories>funding</categories>
  <rfModel>
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:StartNode" name="Start" id="node_1" location="100,100">
      <sourceLinks id="link_1_2" targetNode="node_2"/>
    </nodes>
    
    <!-- Input Validation -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Validate Inputs" id="node_2" location="200,100" rulesetPath="../input_validation">
      <sourceLinks id="link_2_3" targetNode="node_3"/>
    </nodes>
    
    <!-- Age Eligibility -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Age Eligibility Check" id="node_3" location="300,100" rulesetPath="../age/age_eligibility_rules">
      <sourceLinks id="link_3_4" targetNode="node_4"/>
    </nodes>
    
    <!-- Base Program Resolution -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Base Program Resolution" id="node_4" location="400,100" rulesetPath="../program/base_program_resolution">
      <sourceLinks id="link_4_5" targetNode="node_5"/>
    </nodes>
    
    <!-- Pre-Prep Rollout Check -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Pre-Prep Rollout Check" id="node_5" location="500,100" rulesetPath="../program/prep_rollout_rules">
      <sourceLinks id="link_5_6" targetNode="node_6"/>
    </nodes>
    
    <!-- Priority Group Determination -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Priority Group Determination" id="node_6" location="600,100" rulesetPath="../program/priority_group_rules">
      <sourceLinks id="link_6_7" targetNode="node_7"/>
    </nodes>
    
    <!-- Supplement Eligibility -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="ESK Supplement Check" id="node_7" location="700,100" rulesetPath="../supplements/esk_supplement_rules">
      <sourceLinks id="link_7_8" targetNode="node_8"/>
    </nodes>
    
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Additional Year Check" id="node_8" location="800,100" rulesetPath="../supplements/additional_year_rules">
      <sourceLinks id="link_8_9" targetNode="node_9"/>
    </nodes>
    
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="KFS Supplement Check" id="node_9" location="900,100" rulesetPath="../supplements/kfs_supplement_rules">
      <sourceLinks id="link_9_10" targetNode="node_10"/>
    </nodes>
    
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Inclusion Supplement Check" id="node_10" location="1000,100" rulesetPath="../supplements/inclusion_supplement_rules">
