<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.dt:DecisionTable xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.dt="http://ilog.rules.studio/model/dt.ecore">
  <name>Supplement_Eligibility_Table</name>
  <uuid>d7e45cab-3d18-4a5b-852f-3dcbf4f9bf30</uuid>
  <locale>en_US</locale>
  <definition>
<DT xmlns="http://schemas.ilog.com/Rules/7.0/DecisionTable" Version="7.0">
  <Body>
    <Properties>
      <Property Name="Lock.ApplyLocking" Type="xs:boolean"><![CDATA[false]]></Property>
      <Property Name="Lock.LockName" Type="xs:string"><![CDATA[Locked by admin]]></Property>
      <Property Name="UI.ShowRules" Type="xs:boolean"><![CDATA[true]]></Property>
    </Properties>
    <Structure>
      <ConditionDefinitions>
        <ConditionDefinition Id="C0">
          <ExpressionDefinition>
            <Text><![CDATA[the supplement code of 'decision' is <a string>]]></Text>
          </ExpressionDefinition>
        </ConditionDefinition>
        <ConditionDefinition Id="C1">
          <ExpressionDefinition>
            <Text><![CDATA[the effective date <is in range> effective from to effective to]]></Text>
          </ExpressionDefinition>
        </ConditionDefinition>
        <ConditionDefinition Id="C2">
          <ExpressionDefinition>
            <Text><![CDATA[the child's age <is in range> minimum age to maximum age]]></Text>
          </ExpressionDefinition>
        </ConditionDefinition>
        <ConditionDefinition Id="C3">
          <ExpressionDefinition>
            <Text><![CDATA[the child indigenous status is <required>]]></Text>
          </ExpressionDefinition>
        </ConditionDefinition>
        <ConditionDefinition Id="C4">
          <ExpressionDefinition>
            <Text><![CDATA[the child out of home care status is <required>]]></Text>
          </ExpressionDefinition>
        </ConditionDefinition>
        <ConditionDefinition Id="C5">
          <ExpressionDefinition>
            <Text><![CDATA[the child refugee status is <required>]]></Text>
          </ExpressionDefinition>
        </ConditionDefinition>
        <ConditionDefinition Id="C6">
          <ExpressionDefinition>
            <Text><![CDATA[the child disability is <required>]]></Text>
          </ExpressionDefinition>
        </ConditionDefinition>
      </ConditionDefinitions>
      <ActionDefinitions>
        <ActionDefinition Id="A0">
          <ExpressionDefinition>
            <Text><![CDATA[set 'decision' to a new eligibility result where
	the scheme is <supplement code> , 
	the status is ELIGIBLE ,
	add <description> to the reasons,
	add <policy reference> to the policy references]]></Text>
          </ExpressionDefinition>
        </ActionDefinition>
        <ActionDefinition Id="A1">
          <ExpressionDefinition>
            <Text><![CDATA[add <supplement code> to the supplement codes of 'eligibility determination']]></Text>
          </ExpressionDefinition>
        </ActionDefinition>
      </ActionDefinitions>
    </Structure>
    <Contents>
      <Partition DefId="C0">
        <Condition>
          <Expression>
            <Param><![CDATA["ESK"]]></Param>
          </Expression>
          <Partition DefId="C1">
            <Condition>
              <Expression>
                <Param><![CDATA["2023-07-01"]]></Param>
                <Param><![CDATA["2026-06-30"]]></Param>
              </Expression>
              <Partition DefId="C2">
                <Condition>
                  <Expression>
                    <Param><![CDATA[3]]></Param>
                    <Param><![CDATA[4]]></Param>
                  </Expression>
                  <Partition DefId="C3">
                    <Condition>
                      <Expression>
                        <Param><![CDATA[true]]></Param>
                      </Expression>
                      <Partition DefId="C4">
                        <Condition>
                          <Expression>
                            <Param><![CDATA[true]]></Param>
                          </Expression>
                          <Partition DefId="C5">
                            <Condition>
                              <Expression>
                                <Param><![CDATA[true]]></Param>
                              </Expression>
                              <Partition DefId="C6">
                                <Condition>
                                  <Expression>
                                    <Param><![CDATA[false]]></Param>
                                  </Expression>
                                  <ActionSet>
                                    <Action DefId="A0">
                                      <Expression>
                                        <Param><![CDATA["ESK"]]></Param>
                                        <Param><![CDATA["Early Start Kindergarten supplement for Aboriginal/Torres Strait Islander children"]]></Param>
                                        <Param><![CDATA["ESK_POLICY_1.1"]]></Param>
                                      </Expression>
                                    </Action>
                                    <Action DefId="A1">
                                      <Expression>
                                        <Param><![CDATA["ESK"]]></Param>
                                      </Expression>
                                    </Action>
                                  </ActionSet>
                                </Condition>
                              </Partition>
                            </Condition>
                          </Partition>
                        </Condition>
                      </Partition>
                    </Condition>
                  </Partition>
                </Condition>
              </Partition>
            </Condition>
          </Partition>
        </Condition>
      </Partition>
    </Contents>
  </Body>
  <Resources DefaultLocale="en_US">
    <ResourceSet Locale="en_US">
      <Data Name="Definitions(A0)#HeaderText"><![CDATA[Create Eligibility Result]]></Data>
      <Data Name="Definitions(A0)#Width"><![CDATA[384]]></Data>
      <Data Name="Definitions(A1)#HeaderText"><![CDATA[Add Supplement Code]]></Data>
      <Data Name="Definitions(A1)#Width"><![CDATA[224]]></Data>
      <Data Name="Definitions(C0)#HeaderText"><![CDATA[Supplement Code]]></Data>
      <Data Name="Definitions(C0)#Width"><![CDATA[132]]></Data>
      <Data Name="Definitions(C1)#HeaderText"><![CDATA[Effective Date Range]]></Data>
      <Data Name="Definitions(C1)#Width"><![CDATA[172]]></Data>
      <Data Name="Definitions(C2)#HeaderText"><![CDATA[Child Age Range]]></Data>
      <Data Name="Definitions(C2)#Width"><![CDATA[132]]></Data>
      <Data Name="Definitions(C3)#HeaderText"><![CDATA[Indigenous Status Required]]></Data>
      <Data Name="Definitions(C3)#Width"><![CDATA[192]]></Data>
      <Data Name="Definitions(C4)#HeaderText"><![CDATA[OOHC Status Required]]></Data>
      <Data Name="Definitions(C4)#Width"><![CDATA[164]]></Data>
      <Data Name="Definitions(C5)#HeaderText"><![CDATA[Refugee Status Required]]></Data>
      <Data Name="Definitions(C5)#Width"><![CDATA[184]]></Data>
      <Data Name="Definitions(C6)#HeaderText"><![CDATA[Disability Required]]></Data>
      <Data Name="Definitions(C6)#Width"><![CDATA[152]]></Data>
    </ResourceSet>
  </Resources>
</DT>
  </definition>
</ilog.rules.studio.model.dt:DecisionTable>
