<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.dt:DecisionTable xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.dt="http://ilog.rules.studio/model/dt.ecore">
  <n>Age Eligibility Table</n>
  <uuid>j9fnmdj-ffk9-4f64-9f8g-m24feiefeieq</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.dt:DecisionTable xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.dt="http://ilog.rules.studio/model/dt.ecore">
  <name>Age Eligibility Table</name>
  <uuid>j9fnmdj-ffk9-4f64-9f8g-m24feiefeieq</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[<decision-table>
  <input>the LGA code of the service from 'the eligibility request'</input>
  <input>the program year of 'the eligibility request'</input>
  <input>the child's age at the reference date of 'the eligibility request'</input>
  <output>the program type of 'the eligibility result'</output>
  <output>the status of 'the eligibility result'</output>
  <output>the reason</output>
  <rule>
    <condition>any</condition>
    <condition>any</condition>
    <condition>&lt; 3</condition>
    <output>"THREE_YEAR_OLD_KINDER"</output>
    <output>INELIGIBLE</output>
    <output>"Child will be younger than 3 years old on cutoff date"</output>
  </rule>
  <rule>
    <condition>any</condition>
    <condition>any</condition>
    <condition>&lt; 4</condition>
    <output>"PRE_PREP"</output>
    <output>INELIGIBLE</output>
    <output>"Child will be younger than 4 years old on cutoff date"</output>
  </rule>
  <rule>
    <condition>any</condition>
    <condition>any</condition>
    <condition>is at least 3 and &lt; 5</condition>
    <output>"THREE_YEAR_OLD_KINDER"</output>
    <output>ELIGIBLE</output>
    <output>"Child is of eligible age for Three Year Old Kindergarten"</output>
  </rule>
  <rule>
    <condition>any</condition>
    <condition>any</condition>
    <condition>is at least 4 and &lt; 6</condition>
    <output>"PRE_PREP"</output>
    <output>ELIGIBLE</output>
    <output>"Child is of eligible age for Pre-Prep"</output>
  </rule>
  <rule>
    <condition>any</condition>
    <condition>any</condition>
    <condition>is at least 6</condition>
    <output>"THREE_YEAR_OLD_KINDER"</output>
    <output>INELIGIBLE</output>
    <output>"Child will be 6 years or older on cutoff date"</output>
  </rule>
  <rule>
    <condition>any</condition>
    <condition>any</condition>
    <condition>is at least 6</condition>
    <output>"PRE_PREP"</output>
    <output>INELIGIBLE</output>
    <output>"Child will be 6 years or older on cutoff date"</output>
  </rule>
</decision-table>]]]]></definition>
</ilog.rules.studio.model.dt:DecisionTable>
