<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.dt:DecisionTable xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.dt="http://ilog.rules.studio/model/dt.ecore">
  <n>Pre-Prep Hours Entitlement Table</n>
  <uuid>k0gonen-ffl9-4f65-9f8h-n25ffjfffjfr</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.dt:DecisionTable xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.dt="http://ilog.rules.studio/model/dt.ecore">
  <name>Pre-Prep Hours Entitlement Table</name>
  <uuid>k0gonen-ffl9-4f65-9f8h-n25ffjfffjfr</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[<decision-table>
  <input>the funding year of 'the eligibility request'</input>
  <input>the LGA code of the service from 'the eligibility request'</input>
  <input>the child has indigenous status</input>
  <input>the child has refugee or asylum status</input>
  <input>the out of home care status of the child from 'the eligibility request'</input>
  <output>the hours per week approved of 'the funding determination'</output>
  <output>the weeks per year of 'the funding determination'</output>
  <rule>
    <condition>2026</condition>
    <condition>"LGA_301"</condition>
    <condition>true</condition>
    <condition>any</condition>
    <condition>any</condition>
    <output>15</output>
    <output>40</output>
  </rule>
  <rule>
    <condition>2026</condition>
    <condition>"LGA_301"</condition>
    <condition>any</condition>
    <condition>true</condition>
    <condition>any</condition>
    <output>15</output>
    <output>40</output>
  </rule>
  <rule>
    <condition>2026</condition>
    <condition>"LGA_301"</condition>
    <condition>any</condition>
    <condition>any</condition>
    <condition>true</condition>
    <output>15</output>
    <output>40</output>
  </rule>
  <rule>
    <condition>2026</condition>
    <condition>"LGA_301"</condition>
    <condition>false</condition>
    <condition>false</condition>
    <condition>false</condition>
    <output>12.5</output>
    <output>40</output>
  </rule>
  <rule>
    <condition>2026</condition>
    <condition>"LGA_302"</condition>
    <condition>any</condition>
    <condition>any</condition>
    <condition>any</condition>
    <output>12.5</output>
    <output>40</output>
  </rule>
  <rule>
    <condition>2026</condition>
    <condition>"LGA_303"</condition>
    <condition>any</condition>
    <condition>any</condition>
    <condition>any</condition>
    <output>15</output>
    <output>40</output>
  </rule>
  <rule>
    <condition>2026</condition>
    <condition>is not one of "LGA_301", "LGA_302", "LGA_303"</condition>
    <condition>any</condition>
    <condition>any</condition>
    <condition>any</condition>
    <output>12.5</output>
    <output>40</output>
  </rule>
  <rule>
    <condition>2027</condition>
    <condition>any</condition>
    <condition>any</condition>
    <condition>any</condition>
    <condition>any</condition>
    <output>15</output>
    <output>40</output>
  </rule>
</decision-table>]]]]></definition>
</ilog.rules.studio.model.dt:DecisionTable>
