<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <n>Kindergarten Fee Subsidy Eligibility</n>
  <uuid>h7dklbh-fei9-4f62-9f8e-k22fdgcfdgcn</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    'the eligibility request' has guardian with concession "HEALTH_CARE_CARD" 
    or 'the eligibility request' has guardian with concession "PENSIONER_CONCESSION_CARD"
    or 'the eligibility request' has guardian with concession "VETERANS_AFFAIRS_CARD"
    and the processing status of 'the eligibility response' is "IN_PROGRESS"
then
    create a new eligibility result with program type "KFS" and status ELIGIBLE ;
    add reason "Family has eligible concession card" to 'the eligibility result' ;
    add policy reference "KFS_POLICY_3.1" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;
    add supplement code "KFS" to 'the funding determination' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
