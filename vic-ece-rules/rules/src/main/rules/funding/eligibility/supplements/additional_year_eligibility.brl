<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <n>Additional Year Eligibility for VEYLDF Delays</n>
  <uuid>i8emlci-ffj9-4f63-9f8f-l23fehdfehdp</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the VEYLF delays count of the child from 'the eligibility request' is at least 2
    and the base program type of 'the funding determination' is PRE_PREP
    and the processing status of 'the eligibility response' is "IN_PROGRESS"
    and the child from 'the eligibility request' has not completed additional year for PRE_PREP
then
    create a new eligibility result with program type "ADDITIONAL_YEAR" and status ELIGIBLE ;
    add reason "Child has two or more developmental delays based on VEYLF outcomes" to 'the eligibility result' ;
    add policy reference "ADDITIONAL_YEAR_POLICY_4.1" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;
    add supplement code "ADDITIONAL_YEAR" to 'the funding determination' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
