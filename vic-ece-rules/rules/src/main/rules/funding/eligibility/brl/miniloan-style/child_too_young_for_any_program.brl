<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <n>Child Too Young For Any Program</n>
  <uuid>7d3b6e18-f4a9-4c52-9e84-a12c5d3a8f2d</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the child from 'the eligibility request' has date of birth such that
    the child's age on April 30 of the program year is less than 3
    and the processing status of 'the eligibility response' is "IN_PROGRESS"
then
    create a new eligibility result with program type "THREE_YEAR_OLD_KINDER" and status INELIGIBLE ;
    add reason "Child will be younger than 3 years old on April 30 of the program year" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;
    
    create a new eligibility result with program type "PRE_PREP" and status INELIGIBLE ;
    add reason "Child will be younger than 4 years old on April 30 of the program year" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
