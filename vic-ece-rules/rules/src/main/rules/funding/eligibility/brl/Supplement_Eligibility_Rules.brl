package funding.eligibility.criteria;

import funding.EligibilityRequest;
import funding.EligibilityResponse;
import funding.FundingDetermination;
import funding.Child;
import funding.Guardian;
import funding.FundingDetermination.EligibilityStatus;
import funding.FundingDetermination.EligibilityResult;
import funding.Person.IndigenousStatus;
import funding.Child.BaseProgramType;

import java.time.LocalDate;
import java.util.Set;
import java.util.HashSet;

// IBM ODM Rule set for supplement eligibility
ruleset Supplement_Eligibility_Rules {
    // Rule for ESK eligibility based on Indigenous status
    rule "ESK Eligibility for Indigenous Children" {
        property "task" = "funding-eligibility-supplement-check"
        
        when {
            $request: EligibilityRequest();
            $child: Child($child.getIndigenousStatus() != IndigenousStatus.NONE && 
                       $child.getIndigenousStatus() != IndigenousStatus.UNSTATED) from $request.getChild();
            $determination: FundingDetermination();
            $response: EligibilityResponse($response.getProcessingStatus().equals("IN_PROGRESS"));
            
            // Age check - must be 3 or 4 for ESK
            eval(calculateAgeOnReferenceDate($child, $request.getProgramYear(), 4, 30) >= 3);
            eval(calculateAgeOnReferenceDate($child, $request.getProgramYear(), 4, 30) < 5);
        } then {
            EligibilityResult result = new EligibilityResult("ESK", EligibilityStatus.ELIGIBLE);
            result.addReason("Child is of Aboriginal and/or Torres Strait Islander origin");
            result.addPolicyRef("ESK_POLICY_1.1");
            
            $determination.addEligibilityResult(result);
            $determination.addSupplementCode("ESK");
            
            System.out.println("Child is eligible for ESK due to Indigenous status");
        }
    }
    
    // Rule for ESK eligibility based on refugee status
    rule "ESK Eligibility for Refugee or Asylum Seeker Status" {
        property "task" = "funding-eligibility-supplement-check"
        
        when {
            $request: EligibilityRequest();
            $child: Child($child.hasRefugeeOrAsylumStatus()) from $request.getChild();
            $determination: FundingDetermination();
            $response: EligibilityResponse($response.getProcessingStatus().equals("IN_PROGRESS"));
            
            // Age check - must be 3 or 4 for ESK
            eval(calculateAgeOnReferenceDate($child, $request.getProgramYear(), 4, 30) >= 3);
            eval(calculateAgeOnReferenceDate($child, $request.getProgramYear(), 4, 30) < 5);
        } then {
            EligibilityResult result = new EligibilityResult("ESK", EligibilityStatus.ELIGIBLE);
            result.addReason("Child has refugee or asylum seeker status");
            result.addPolicyRef("ESK_POLICY_1.3");
            
            $determination.addEligibilityResult(result);
            $determination.addSupplementCode("ESK");
            
            System.out.println("Child is eligible for ESK due to refugee status");
        }
    }
    
    // Rule for ESK eligibility based on out of home care
    rule "ESK Eligibility for Out of Home Care" {
        property "task" = "funding-eligibility-supplement-check"
        
        when {
            $request: EligibilityRequest();
            $child: Child($child.isOutOfHomeCareStatus()) from $request.getChild();
            $determination: FundingDetermination();
            $response: EligibilityResponse($response.getProcessingStatus().equals("IN_PROGRESS"));
            
            // Age check - must be 3 or 4 for ESK
            eval(calculateAgeOnReferenceDate($child, $request.getProgramYear(), 4, 30) >= 3);
            eval(calculateAgeOnReferenceDate($child, $request.getProgramYear(), 4, 30) < 5);
        } then {
            EligibilityResult result = new EligibilityResult("ESK", EligibilityStatus.ELIGIBLE);
            result.addReason("Child is in Out of Home Care");
            result.addPolicyRef("ESK_POLICY_1.2");
            
            $determination.addEligibilityResult(result);
            $determination.addSupplementCode("ESK");
            
            System.out.println("Child is eligible for ESK due to out of home care status");
        }
    }
    
    // Rule for inclusion support eligibility
    rule "Inclusion Support Eligibility" {
        property "task" = "funding-eligibility-supplement-check"
        
        when {
            $request: EligibilityRequest();
            $child: Child($child.isDisabilityOrAddNeeds()) from $request.getChild();
            $determination: FundingDetermination();
            $response: EligibilityResponse($response.getProcessingStatus().equals("IN_PROGRESS"));
            
            // Age check - must be 3-5 for inclusion support
            eval(calculateAgeOnReferenceDate($child, $request.getProgramYear(), 4, 30) >= 3);
            eval(calculateAgeOnReferenceDate($child, $request.getProgramYear(), 4, 30) < 6);
        } then {
            EligibilityResult result = new EligibilityResult("INCLUSION", EligibilityStatus.ELIGIBLE);
            result.addReason("Child has disability or additional needs");
            result.addPolicyRef("INCLUSION_POLICY_2.1");
            
            $determination.addEligibilityResult(result);
            $determination.addSupplementCode("INCLUSION");
            
            System.out.println("Child is eligible for inclusion support");
        }
    }
    
    // Rule for KFS eligibility based on concession cards
    rule "Kindergarten Fee Subsidy Eligibility for Concession Card" {
        property "task" = "funding-eligibility-supplement-check"
        
        when {
            $request: EligibilityRequest($request.getGuardians() != null && $request.getGuardians().size() > 0);
            $determination: FundingDetermination();
            $response: EligibilityResponse($response.getProcessingStatus().equals("IN_PROGRESS"));
            
            // Check for eligible concessions
            eval(hasEligibleConcession($request.getGuardians()));
        } then {
            EligibilityResult result = new EligibilityResult("KFS", EligibilityStatus.ELIGIBLE);
            result.addReason("Family has eligible concession card");
            result.addPolicyRef("KFS_POLICY_3.1");
            
            $determination.addEligibilityResult(result);
            $determination.addSupplementCode("KFS");
            
            System.out.println("Child is eligible for Kindergarten Fee Subsidy");
        }
    }
    
    // Rule for additional year eligibility
    rule "Additional Year Eligibility for VEYLDF Delays" {
        property "task" = "funding-eligibility-supplement-check"
        
        when {
            $request: EligibilityRequest();
            $child: Child($child.getVeylfDelaysCount() >= 2) from $request.getChild();
            $determination: FundingDetermination($determination.getBaseProgramType() == BaseProgramType.PRE_PREP);
            $response: EligibilityResponse($response.getProcessingStatus().equals("IN_PROGRESS"));
        } then {
            EligibilityResult result = new EligibilityResult("ADDITIONAL_YEAR", EligibilityStatus.ELIGIBLE);
            result.addReason("Child has two or more developmental delays based on VEYLF outcomes");
            result.addPolicyRef("ADDITIONAL_YEAR_POLICY_4.1");
            
            $determination.addEligibilityResult(result);
            $determination.addSupplementCode("ADDITIONAL_YEAR");
            
            System.out.println("Child is eligible for an additional year of funded kindergarten");
        }
    }
    
    // Helper function to calculate age on reference date
    function int calculateAgeOnReferenceDate(Child child, int year, int month, int day) {
        if (child == null || child.getDateOfBirth() == null) {
            return -1;
        }
        
        LocalDate referenceDate = LocalDate.of(year, month, day);
        return child.getAgeAt(referenceDate);
    }
    
    // Helper function to check for eligible concessions
    function boolean hasEligibleConcession(java.util.List<Guardian> guardians) {
        for (Guardian guardian : guardians) {
            if (guardian.hasConcession("HEALTH_CARE_CARD") || 
                guardian.hasConcession("PENSIONER_CONCESSION_CARD") || 
                guardian.hasConcession("VETERANS_AFFAIRS_CARD")) {
                return true;
            }
        }
        return false;
    }
}
