  <locale>en_US</locale>
  <categories>funding</categories>
  <rfModel>
    <tasks name="Input Validation" type="RuleTask">
      <description>Validate All Request Inputs</description>
      <task>funding-eligibility-validation</task>
      <ExecutionMode>Fastpath</ExecutionMode>
      <ExitCriteria>None</ExitCriteria>
      <taskDefinition>
        <RuleList>
          <Package Name="funding.eligibility.validation"/>
        </RuleList>
      </taskDefinition>
    </tasks>
    <tasks name="Validation Check" type="DecisionTask">
      <description>Check Validation Results</description>
    </tasks>
    <tasks name="Validation Failed" type="StopTask" termination="true">
      <description>Validation Failed - End Flow</description>
    </tasks>
    <tasks name="Age Eligibility" type="RuleTask">
      <description>Check Age-Based Eligibility</description>
      <task>funding-eligibility-age-check</task>
      <ExecutionMode>RetePlus</ExecutionMode>
      <ExitCriteria>None</ExitCriteria>
      <taskDefinition>
        <RuleList>
          <Package Name="funding.eligibility.age"/>
        </RuleList>
      </taskDefinition>
    </tasks>
    <tasks name="Service Eligibility" type="RuleTask">
      <description>Check Service Provider Eligibility</description>
      <task>funding-eligibility-service-check</task>
      <ExecutionMode>RetePlus</ExecutionMode>
      <ExitCriteria>None</ExitCriteria>
      <taskDefinition>
        <RuleList>
          <Package Name="funding.eligibility.service"/>
        </RuleList>
      </taskDefinition>
    </tasks>
    <tasks name="Program Rules" type="RuleTask">
      <description>Apply Program-Specific Rules</description>
      <task>funding-eligibility-program-specific</task>
      <ExecutionMode>RetePlus</ExecutionMode>
      <ExitCriteria>None</ExitCriteria>
      <taskDefinition>
        <RuleList>
          <Package Name="funding.eligibility.program"/>
        </RuleList>
      </taskDefinition>
    </tasks>
    <tasks name="Supplement Eligibility" type="RuleTask">
      <description>Check Supplement Eligibility</description>
      <task>funding-eligibility-supplement-check</task>
      <ExecutionMode>RetePlus</ExecutionMode>
      <ExitCriteria>None</ExitCriteria>
      <taskDefinition>
        <RuleList>
          <Package Name="funding.eligibility.supplements"/>
        </RuleList>
      </taskDefinition>
    </tasks>
    <tasks name="Output Preparation" type="RuleTask">
      <description>Finalize Output Response</description>
      <task>funding-eligibility-output</task>
      <ExecutionMode>Fastpath</ExecutionMode>
      <ExitCriteria>None</ExitCriteria>
    </tasks>
    <tasks name="End" type="StopTask" termination="true">
      <description>Normal Flow Completion</description>
    </tasks>
