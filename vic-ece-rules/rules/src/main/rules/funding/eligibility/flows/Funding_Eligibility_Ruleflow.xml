<?xml version="1.0" encoding="UTF-8"?>
<ruleflow-group xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.ibm.com/rules/ruleflow/1.0" xsi:schemaLocation="http://www.ibm.com/rules/ruleflow/1.0 ruleflow.xsd">
  <header>
    <name>Funding_Eligibility_Ruleflow</name>
    <uuid>b6e89cab-3d18-4a5b-852f-3dcbf4f9bf29</uuid>
    <properties>
      <property name="description" value="Ruleflow for determining funding eligibility"/>
      <property name="author" value="Victorian Government"/>
      <property name="creationDate" value="2025-09-17"/>
      <property name="version" value="1.0"/>
    </properties>
  </header>
  <nodes>
    <start id="start">
      <name>Start</name>
      <x>80</x>
      <y>50</y>
      <width>30</width>
      <height>30</height>
    </start>
    <task id="initialization">
      <name>Initialization</name>
      <x>80</x>
      <y>120</y>
      <width>120</width>
      <height>40</height>
      <type>RuleTask</type>
      <rulesetName>Initialization</rulesetName>
      <properties>
        <property name="description" value="Initialize Response Object"/>
      </properties>
    </task>
    <task id="validation">
      <name>Input Validation</name>
      <x>80</x>
      <y>190</y>
      <width>120</width>
      <height>40</height>
      <type>RuleTask</type>
      <rulesetName>funding-eligibility-validation</rulesetName>
      <properties>
        <property name="description" value="Validate All Request Inputs"/>
      </properties>
    </task>
    <decision id="validationCheck">
      <name>Validation Check</name>
      <x>80</x>
      <y>260</y>
      <width>120</width>
      <height>40</height>
    </decision>
    <task id="ageEligibility">
      <name>Age Eligibility</name>
      <x>80</x>
      <y>330</y>
      <width>120</width>
      <height>40</height>
      <type>RuleTask</type>
      <rulesetName>funding-eligibility-age-check</rulesetName>
      <properties>
        <property name="description" value="Check Age-Based Eligibility"/>
      </properties>
    </task>
    <task id="serviceEligibility">
      <name>Service Eligibility</name>
      <x>80</x>
      <y>400</y>
      <width>120</width>
      <height>40</height>
      <type>RuleTask</type>
      <rulesetName>funding-eligibility-service-check</rulesetName>
      <properties>
        <property name="description" value="Check Service Provider Eligibility"/>
      </properties>
    </task>
    <task id="programSpecific">
      <name>Program Rules</name>
      <x>80</x>
      <y>470</y>
      <width>120</width>
      <height>40</height>
      <type>RuleTask</type>
      <rulesetName>funding-eligibility-program-specific</rulesetName>
      <properties>
        <property name="description" value="Apply Program-Specific Rules"/>
      </properties>
    </task>
    <task id="supplementCheck">
      <name>Supplement Eligibility</name>
      <x>80</x>
      <y>540</y>
      <width>120</width>
      <height>40</height>
      <type>RuleTask</type>
      <rulesetName>funding-eligibility-supplement-check</rulesetName>
      <properties>
        <property name="description" value="Check Supplement Eligibility"/>
      </properties>
    </task>
    <task id="outputFormat">
      <name>Output Preparation</name>
      <x>80</x>
      <y>610</y>
      <width>120</width>
      <height>40</height>
      <type>RuleTask</type>
      <rulesetName>funding-eligibility-output</rulesetName>
      <properties>
        <property name="description" value="Finalize Output Response"/>
      </properties>
    </task>
    <stop id="validationStop">
      <name>Validation Failure</name>
      <x>230</x>
      <y>260</y>
      <width>30</width>
      <height>30</height>
    </stop>
    <stop id="end">
      <name>End</name>
      <x>80</x>
      <y>680</y>
      <width>30</width>
      <height>30</height>
    </stop>
  </nodes>
  <transitions>
    <transition from="start" to="initialization"/>
    <transition from="initialization" to="validation"/>
    <transition from="validation" to="validationCheck"/>
    <transition from="validationCheck" to="ageEligibility">
      <condition>processingStatus != "ERROR"</condition>
    </transition>
    <transition from="validationCheck" to="validationStop">
      <condition>processingStatus == "ERROR"</condition>
    </transition>
    <transition from="ageEligibility" to="serviceEligibility"/>
    <transition from="serviceEligibility" to="programSpecific"/>
    <transition from="programSpecific" to="supplementCheck"/>
    <transition from="supplementCheck" to="outputFormat"/>
    <transition from="outputFormat" to="end"/>
  </transitions>
</ruleflow-group>
