package funding.eligibility.flows;

import funding.EligibilityRequest;
import funding.EligibilityResponse;
import funding.FundingDetermination;
import funding.Child;
import funding.Person;
import funding.Service;
import funding.Family;
import funding.Guardian;
import funding.FundingDetermination.EligibilityStatus;
import funding.FundingDetermination.EligibilityResult;

// Define ruleflow metadata
ruleflow-group "funding-eligibility-validation"
ruleflow-group "funding-eligibility-age-check"
ruleflow-group "funding-eligibility-service-check"
ruleflow-group "funding-eligibility-program-specific"
ruleflow-group "funding-eligibility-supplement-check"
ruleflow-group "funding-eligibility-output"

rule "Initialize Response"
    no-loop true
    salience 1000
    when
        $request : EligibilityRequest()
        not (EligibilityResponse())
    then
        FundingDetermination determination = new FundingDetermination();
        
        // Initialize with base program type from request if present
        if ($request.getApplication() != null && 
            $request.getApplication().getRequestedBaseProgramType() != null) {
            determination.setBaseProgramType($request.getApplication().getRequestedBaseProgramType());
        }
        
        // Set effective dates (usually financial year)
        java.time.LocalDate startDate = java.time.LocalDate.of($request.getFundingYear(), 7, 1);
        java.time.LocalDate endDate = java.time.LocalDate.of($request.getFundingYear() + 1, 6, 30);
        determination.setEffectiveFrom(startDate);
        determination.setEffectiveTo(endDate);
        
        // Initialize response
        EligibilityResponse response = new EligibilityResponse(determination);
        response.setProcessingStatus("IN_PROGRESS");
        response.setRequestId(java.util.UUID.randomUUID().toString());
        response.setTimestamp(java.time.LocalDateTime.now().toString());
        
        insert(determination);
        insert(response);
        
        System.out.println("Eligibility response initialized with ID: " + response.getRequestId());
end

rule "Input Validation Failure"
    no-loop true
    salience 900
    when
        $response : EligibilityResponse(processingStatus == "ERROR")
    then
        System.out.println("Validation failure detected, terminating rule execution");
        drools.halt();
end

rule "Finalize Response"
    no-loop true
    salience -1000
    when
        $response : EligibilityResponse(processingStatus == "IN_PROGRESS")
        $determination : FundingDetermination()
    then
        // Set final status based on eligibility results
        $response.setProcessingStatus("SUCCESS");
        
        // Set primary program
        if ($determination.getBaseProgramType() != null) {
            $response.setPrimaryProgram($determination.getBaseProgramType().toString());
        }
        
        System.out.println("Eligibility determination completed successfully");
end
