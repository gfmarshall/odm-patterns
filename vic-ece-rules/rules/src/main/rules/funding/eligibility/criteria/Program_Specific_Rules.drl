package funding.eligibility.criteria;

import funding.EligibilityRequest;
import funding.EligibilityResponse;
import funding.FundingDetermination;
import funding.Child;
import funding.Service;
import funding.FundingDetermination.EligibilityStatus;
import funding.FundingDetermination.EligibilityResult;
import funding.Child.BaseProgramType;

// Ruleflow group for program-specific eligibility checks
ruleflow-group "funding-eligibility-program-specific"

rule "Check Three Year Old Kindergarten Service Hours"
    no-loop true
    when
        $request : EligibilityRequest(child != null, service != null)
        $service : Service() from $request.getService()
        $determination : FundingDetermination(baseProgramType == BaseProgramType.THREE_YEAR_OLD_KINDER)
        $response : EligibilityResponse(processingStatus == "IN_PROGRESS")
        
        // Check if service has THREE_YEAR_OLD cohort hours defined
        eval($service.getPrePrepHoursByCohort().containsKey("THREE_YEAR_OLD") || 
             $service.getPrePrepHoursByCohort().containsKey("UNIVERSAL"))
    then
        // Calculate hours based on funding year
        int standardHours = 5; // Default for 2023
        if ($request.getFundingYear() == 2024) {
            standardHours = 7;
        } else if ($request.getFundingYear() >= 2025) {
            standardHours = 10;
        }
        
        // Set hours in determination
        modify($determination) {
            setHoursPerWeekApproved(standardHours),
            setWeeksPerYear(40)
        }
        
        System.out.println("THREE_YEAR_OLD_KINDER hours set to " + standardHours + " per week");
end

rule "Check Pre-Prep Service Hours"
    no-loop true
    when
        $request : EligibilityRequest(child != null, service != null)
        $service : Service() from $request.getService()
        $determination : FundingDetermination(baseProgramType == BaseProgramType.PRE_PREP)
        $response : EligibilityResponse(processingStatus == "IN_PROGRESS")
        
        // Check if service has PRE_PREP cohort hours defined
        eval($service.getPrePrepHoursByCohort().containsKey("PRE_PREP") || 
             $service.getPrePrepHoursByCohort().containsKey("UNIVERSAL"))
    then
        // Calculate hours - fixed at 15 hours
        int standardHours = 15; 
        
        // Set hours in determination
        modify($determination) {
            setHoursPerWeekApproved(standardHours),
            setWeeksPerYear(40)
        }
        
        System.out.println("PRE_PREP hours set to " + standardHours + " per week");
end

rule "Apply ESK Hours Increase"
    no-loop true
    salience -100 // Run after standard hour calculation
    when
        $request : EligibilityRequest(child != null)
        $determination : FundingDetermination(hasSupplementCode("ESK"), 
                                            hoursPerWeekApproved < 15)
        $response : EligibilityResponse(processingStatus == "IN_PROGRESS")
    then
        // ESK increases hours to 15 hours per week
        modify($determination) {
            setHoursPerWeekApproved(15)
        }
        
        System.out.println("Applied ESK hours increase to 15 hours per week");
end

rule "Apply Inclusion Support Hours"
    no-loop true
    salience -110 // Run after ESK hour calculation
    when
        $request : EligibilityRequest(child != null)
        $determination : FundingDetermination(hasSupplementCode("INCLUSION"))
        $response : EligibilityResponse(processingStatus == "IN_PROGRESS")
    then
        // Add 5 additional hours for inclusion support, up to a maximum of 15
        int currentHours = $determination.getHoursPerWeekApproved();
        int newHours = Math.min(currentHours + 5, 15);
        
        modify($determination) {
            setHoursPerWeekApproved(newHours)
        }
        
        System.out.println("Applied inclusion support hours: added additional hours up to maximum 15");
end
