// IBM ODM IRL Rule: Age Eligibility Rules

definitions
    use funding.EligibilityRequest;
    use funding.EligibilityResponse;
    use funding.FundingDetermination;
    use funding.Child;
    use funding.Child.BaseProgramType;
    use funding.FundingDetermination.EligibilityResult;
    use funding.FundingDetermination.EligibilityStatus;
end

rule ThreeYearOldKindergartenEligibility {
    property "jes:ruleset" = "funding.eligibility";
    property "jes:task" = "funding-eligibility-age-check";
    property "priority" = 50;
    
    when {
        request: EligibilityRequest();
        child: Child() from request.getChild();
        response: EligibilityResponse() where response.getProcessingStatus() == "IN_PROGRESS";
        determination: FundingDetermination() 
            where determination.getBaseProgramType() == BaseProgramType.THREE_YEAR_OLD_KINDER 
               or determination.getBaseProgramType() == null;
        
        // Check age eligibility (3-4 years)
        evaluate (this.calculateAge(child, request.getProgramYear()) >= 3);
        evaluate (this.calculateAge(child, request.getProgramYear()) < 5);
    } then {
        // Create eligibility result
        EligibilityResult result = new EligibilityResult("THREE_YEAR_OLD_KINDER", EligibilityStatus.ELIGIBLE);
        result.addReason("Child will be between 3 and 4 years old on April 30 of the program year");
        result.addPolicyRef("AGE_ELIGIBILITY_POLICY_1.2");
        
        // Update determination
        determination.setBaseProgramType(BaseProgramType.THREE_YEAR_OLD_KINDER);
        determination.addEligibilityResult(result);
        
        print("Child is age-eligible for Three Year Old Kindergarten");
    }
}

rule PrePrepEligibility {
    property "jes:ruleset" = "funding.eligibility";
    property "jes:task" = "funding-eligibility-age-check";
    property "priority" = 40;
    
    when {
        request: EligibilityRequest();
        child: Child() from request.getChild();
        response: EligibilityResponse() where response.getProcessingStatus() == "IN_PROGRESS";
        determination: FundingDetermination() 
            where determination.getBaseProgramType() == BaseProgramType.PRE_PREP 
               or determination.getBaseProgramType() == null;
        
        // Check age eligibility (4-5 years)
        evaluate (this.calculateAge(child, request.getProgramYear()) >= 4);
        evaluate (this.calculateAge(child, request.getProgramYear()) < 6);
    } then {
        // Create eligibility result
        EligibilityResult result = new EligibilityResult("PRE_PREP", EligibilityStatus.ELIGIBLE);
        result.addReason("Child will be between 4 and 5 years old on April 30 of the program year");
        result.addPolicyRef("AGE_ELIGIBILITY_POLICY_2.1");
        
        // Update determination
        determination.setBaseProgramType(BaseProgramType.PRE_PREP);
        determination.addEligibilityResult(result);
        
        print("Child is age-eligible for Pre-Prep");
    }
}

rule ChildTooYoungForAnyProgram {
    property "jes:ruleset" = "funding.eligibility";
    property "jes:task" = "funding-eligibility-age-check";
    property "priority" = 30;
    
    when {
        request: EligibilityRequest();
        child: Child() from request.getChild();
        response: EligibilityResponse() where response.getProcessingStatus() == "IN_PROGRESS";
        determination: FundingDetermination();
        
        // Check if child is too young (under 3)
        evaluate (this.calculateAge(child, request.getProgramYear()) < 3);
    } then {
        // Create ineligible results for both programs
        EligibilityResult result1 = new EligibilityResult("THREE_YEAR_OLD_KINDER", EligibilityStatus.INELIGIBLE);
        result1.addReason("Child will be younger than 3 years old on April 30 of the program year");
        
        EligibilityResult result2 = new EligibilityResult("PRE_PREP", EligibilityStatus.INELIGIBLE);
        result2.addReason("Child will be younger than 4 years old on April 30 of the program year");
        
        determination.addEligibilityResult(result1);
        determination.addEligibilityResult(result2);
        
        print("Child is too young for any kindergarten program");
    }
}

function integer calculateAge(Child child, integer programYear) {
    // Reference date is April 30 of the program year
    java.time.LocalDate referenceDate = java.time.LocalDate.of(programYear, 4, 30);
    return child.getAgeAt(referenceDate);
}
