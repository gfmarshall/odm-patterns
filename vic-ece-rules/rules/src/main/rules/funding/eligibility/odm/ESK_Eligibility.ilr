// IBM ODM IRL Rule: ESK Eligibility for Indigenous Children

definitions
    use funding.EligibilityRequest;
    use funding.EligibilityResponse;
    use funding.FundingDetermination;
    use funding.Child;
    use funding.Person.IndigenousStatus;
    use funding.FundingDetermination.EligibilityResult;
    use funding.FundingDetermination.EligibilityStatus;
end

rule ESK_Eligibility_Indigenous {
    property "jes:ruleset" = "funding.eligibility";
    property "jes:task" = "funding-eligibility-supplement-check";
    property "priority" = 50;
    
    when {
        request: EligibilityRequest();
        child: Child() from request.getChild();
        response: EligibilityResponse() where response.getProcessingStatus() == "IN_PROGRESS";
        determination: FundingDetermination();
        
        // Check that child has indigenous status
        evaluate (child.getIndigenousStatus() != IndigenousStatus.NONE);
        evaluate (child.getIndigenousStatus() != IndigenousStatus.UNSTATED);
        
        // Check age eligibility (3-4 years)
        evaluate (this.calculateAge(child, request.getProgramYear()) >= 3);
        evaluate (this.calculateAge(child, request.getProgramYear()) < 5);
    } then {
        // Create eligibility result
        EligibilityResult result = new EligibilityResult("ESK", EligibilityStatus.ELIGIBLE);
        result.addReason("Child is of Aboriginal and/or Torres Strait Islander origin");
        result.addPolicyRef("ESK_POLICY_1.1");
        
        // Update determination
        determination.addEligibilityResult(result);
        determination.addSupplementCode("ESK");
        
        print("Child is eligible for ESK due to Indigenous status");
    }
}

function integer calculateAge(Child child, integer programYear) {
    // Reference date is April 30 of the program year
    java.time.LocalDate referenceDate = java.time.LocalDate.of(programYear, 4, 30);
    return child.getAgeAt(referenceDate);
}
