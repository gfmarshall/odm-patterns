<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <n>Service Not Eligible</n>
  <uuid>a06e9f4a-f7b9-4f55-9f87-d15f8f6c9f5g</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the service from 'the eligibility request' is not eligible to deliver funded kindergarten
    and the processing status of 'the eligibility response' is "IN_PROGRESS"
then
    create a new eligibility result with program type "SERVICE_ELIGIBILITY" and status INELIGIBLE ;
    add reason "Service is not approved to deliver Victorian funded kindergarten programs" to 'the eligibility result' ;
    add policy reference "SERVICE_APPROVAL_POLICY_1.1" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;
    
    create a new eligibility result with program type "THREE_YEAR_OLD_KINDER" and status INELIGIBLE ;
    add reason "Service is not eligible to deliver funded programs" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;
    
    create a new eligibility result with program type "PRE_PREP" and status INELIGIBLE ;
    add reason "Service is not eligible to deliver funded programs" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
