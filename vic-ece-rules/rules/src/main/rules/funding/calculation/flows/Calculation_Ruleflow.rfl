      <sourceLinks id="Link_5_6" targetNode="6"/>
    </nodes>
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:TaskNode" id="6" name="Supplement Components" x="109" y="373">
      <sourceLinks id="Link_6_7" targetNode="7"/>
