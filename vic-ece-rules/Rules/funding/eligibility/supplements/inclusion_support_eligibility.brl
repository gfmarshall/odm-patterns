<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <n>Inclusion Support Eligibility</n>
  <uuid>g6cjkag-fdh9-4f61-9f8d-j21fcgbfcgbm</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the disability or additional needs of the child from 'the eligibility request' is true
    and the child's age at the reference date of 'the eligibility request' is at least 3
    and the child's age at the reference date of 'the eligibility request' is less than 6
    and the processing status of 'the eligibility response' is "IN_PROGRESS"
then
    create a new eligibility result with program type "INCLUSION" and status ELIGIBLE ;
    add reason "Child has disability or additional needs" to 'the eligibility result' ;
    add policy reference "INCLUSION_POLICY_2.1" to 'the eligibility result' ;
    add 'the eligibility result' to 'the funding determination' ;
    add supplement code "INCLUSION" to 'the funding determination' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
