        {"scheme": "PRE_PREP", "status": "ELIGIBLE"},
        {"scheme": "PRIORITY_GROUP", "status": "ELIGIBLE"},
        {"scheme": "FREE_KINDER", "status": "ELIGIBLE"}
      ]
    }
  },
