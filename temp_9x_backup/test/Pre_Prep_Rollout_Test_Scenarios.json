      },
      "service": {
        "serviceId": "S-1",
        "lgaCode": "LGA_301",
        "deliversVicGovFundedKindergartenProgramInYear": true,
        "participatesInFreeKinder": true,
        "prePrepConfig": {
          "rolloutYear": 2026,
          "rolloutGroup": "PHASE_1",
          "initialHours": 20,
          "midStageHours": 25,
          "finalHours": 30,
          "midStageYear": 2029,
          "finalStageYear": 2031
        }
      },
      "application": {
        "requestedBaseProgramType": "PRE_PREP",
        "requestedWeeklyHours": 25
      }
    },
    "expectedOutput": {
