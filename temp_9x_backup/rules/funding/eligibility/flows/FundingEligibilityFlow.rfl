    </nodes>
    
    <!-- Output Preparation -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Output Preparation" id="node_6" location="687,122">
      <ruleTask href="../#Output_Preparation_Task"/>
