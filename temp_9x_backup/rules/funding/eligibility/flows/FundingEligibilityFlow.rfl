<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.ruleflow:RuleFlow xmi:version="2.0" 
    xmlns:xmi="http://www.omg.org/XMI" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xmlns:ilog.rules.studio.model.ruleflow="http://ilog.rules.studio/model/ruleflow.ecore">
  <name>FundingEligibilityFlow</name>
  <uuid>4b6e89ca-3d18-4a5b-852f-3dcbf4f9bf29</uuid>
  <locale>en_US</locale>
  <categories>funding</categories>
  <rfModel>
    <!-- Start Node -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:StartNode" name="Start" id="node_0" location="50,122">
      <sourceLinks id="link_0_1" targetNode="node_1"/>
    </nodes>
    
    <!-- Input Validation -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Input Validation" id="node_1" location="141,122">
      <ruleTask href="../validation#Input_Validation_Task"/>
      <sourceLinks id="link_1_2" targetNode="node_2"/>
    </nodes>
    
    <!-- Validation Decision -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:DecisionNode" name="Validation Decision" id="node_2" location="232,122">
      <sourceLinks id="link_2_3" targetNode="node_3">
        <condition><![CDATA[processingStatus != "ERROR"]]></condition>
      </sourceLinks>
      <sourceLinks id="link_2_9" targetNode="node_9">
        <condition><![CDATA[processingStatus == "ERROR"]]></condition>
      </sourceLinks>
    </nodes>
    
    <!-- Age Eligibility -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Age Eligibility" id="node_3" location="323,122">
      <ruleTask href="../age#Age_Eligibility_Task"/>
      <sourceLinks id="link_3_4" targetNode="node_4"/>
    </nodes>
    
    <!-- Service Eligibility -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Service Eligibility" id="node_4" location="414,122">
      <ruleTask href="../service#Service_Eligibility_Task"/>
      <sourceLinks id="link_4_8" targetNode="node_8"/>
    </nodes>
    
    <!-- Program Rules -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Program Rules" id="node_8" location="505,122">
      <ruleTask href="../program#Program_Rules_Task"/>
      <sourceLinks id="link_8_5" targetNode="node_5"/>
