    <!-- Supplement Eligibility -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:RuleTask" name="Supplement Eligibility" id="node_5" location="596,122">
      <ruleTask href="../supplements#Supplement_Eligibility_Task"/>
