    <!-- Stop Node -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:StopNode" name="Stop" id="node_7" location="778,122"/>
    
    <!-- Validation Failed Stop Node -->
    <nodes xsi:type="ilog.rules.studio.model.ruleflow:StopNode" name="ValidationFailed" id="node_9" location="232,232"/>
